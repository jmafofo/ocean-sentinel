{
  "expo": {
    "name": "Ocean Sentinel",
    "slug": "ocean-sentinel",
    "version": "1.0.1",
    "scheme": "com.oceansentinel.app",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a1628"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.oceansentinel.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Ocean Sentinel needs camera access to identify fish species.",
        "NSPhotoLibraryUsageDescription": "Ocean Sentinel needs photo library access to identify fish from your gallery.",
        "NSLocationWhenInUseUsageDescription": "Ocean Sentinel uses your location to record where fish were spotted.",
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "remote-notification"
        ]
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyCollectedDataTypes": [
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeLocation",
            "NSPrivacyCollectedDataTypeLinked": false,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypePhotosorVideos",
            "NSPrivacyCollectedDataTypeLinked": false,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          }
        ],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a1628"
      },
      "package": "com.oceansentinel.app",
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "versionCode": 4,
      "gradleProperties": {
        "org.gradle.jvmargs": "-Xmx4096m -XX:MaxMetaspaceSize=512m"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Ocean Sentinel needs camera access to identify fish species."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Ocean Sentinel needs photo library access to identify fish from your gallery.",
          "cameraPermission": "Ocean Sentinel needs camera access to identify fish species."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Ocean Sentinel uses your location to record where fish were spotted."
        }
      ],
      [
        "expo-sqlite",
        {
          "enableFTS": true,
          "useSQLCipher": false
        }
      ],
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "color": "#00d4aa"
        }
      ]
    ],
    "updates": {
      "url": "https://u.expo.dev/5e87df30-69c5-47d9-810e-f694f8008198",
      "enabled": true,
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_LOAD"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "modelCacheVersion": "1",
      "eas": {
        "projectId": "5e87df30-69c5-47d9-810e-f694f8008198"
      }
    },
    "owner": "mafofoj"
  }
}